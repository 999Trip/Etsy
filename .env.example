# Copy this file to .env and fill in your own values. Never commit .env.

# --- Etsy (https://www.etsy.com/developers/register) ---
# "Keystring" shown on your app's page after registering it.
ETSY_KEYSTRING=
# "Shared secret" shown on the same app page - the Etsy API v3 requires
# both, combined as "keystring:shared_secret", in the x-api-key header.
ETSY_SHARED_SECRET=
# Your shop's numeric id (Shop Manager > Settings, or the URL of your shop).
ETSY_SHOP_ID=
# Must exactly match a redirect URI registered on your Etsy app at
# https://www.etsy.com/developers/your-apps - Etsy requires https even
# for localhost, with no exception (plain http fails).
ETSY_REDIRECT_URI=https://localhost:3003/oauth/redirect
# Populated automatically by `python -m integrations.etsy_oauth` - do not
# set this by hand, it's written to .etsy_token.json instead.

# --- Printify (https://printify.com/app/account/api) ---
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
